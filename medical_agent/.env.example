# Never commit real credentials. Set these in the Maze head/worker environment.
# Name must match `api_key_env` in config/llm_config.yaml.
LLM_API_KEY=

# Read-only retrieval settings. These must match the pre-built index
# manifest (data/rag/manifest.json); otherwise retrieval is refused.
MEDICAL_RAG_EMBEDDING_PROVIDER=
MEDICAL_RAG_EMBEDDING_MODEL=
MEDICAL_RAG_EMBEDDING_DIMENSIONS=

# Path to the read-only RAG runtime (retriever code and its config/),
# which is not distributed with this package.
MEDICAL_RAG_RUNTIME_ROOT=
